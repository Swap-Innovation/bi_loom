# Database
DATABASE_URL=postgresql+asyncpg://migration:migration@postgres:5432/bi_loom

# AI — keys live in secrets/cursor.env (see scripts/setup-secrets.sh)
AI_MODE=mock
CURSOR_API_KEY=
CURSOR_MODEL=auto
CURSOR_API_BASE_URL=https://api.cursor.com
CURSOR_AGENT_POOL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Confidence thresholds
CONFIDENCE_HIGH_THRESHOLD=90
CONFIDENCE_MEDIUM_THRESHOLD=70

# Storage
STORAGE_BACKEND=local
STORAGE_PATH=/data/artifacts

# App
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=100
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Migration score weights (must sum to 1.0)
SCORE_WEIGHT_MAPPING_COVERAGE=0.40
SCORE_WEIGHT_MAPPING_CONFIDENCE=0.20
SCORE_WEIGHT_REPORT_COVERAGE=0.20
SCORE_WEIGHT_VISUAL_COVERAGE=0.10
SCORE_WEIGHT_VALIDATION=0.10
